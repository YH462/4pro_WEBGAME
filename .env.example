DATABASE_URL="postgresql://fourpro:local_fourpro@127.0.0.1:5432/fourpro?schema=public"
APP_URL="http://localhost:3000"
EVENT_ID="local-exhibition"
SESSION_DAYS="30"
# HTTP is allowed only on localhost/127.0.0.1/::1. Use HTTPS at the venue.
ALLOW_INSECURE_LOCAL_HTTP="true"
# Never enable on a venue/public server.
ENABLE_DEV_SIMULATOR="true"
# Home survey banner: leave empty to display 準備中. Set the external form URL later.
KOSEN_SURVEY_URL=""
